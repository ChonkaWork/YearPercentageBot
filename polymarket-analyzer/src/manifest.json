{
  "manifest_version": 3,
  "name": "Polymarket AI Analyzer",
  "short_name": "Polymarket AI",
  "version": "0.0.0",
  "description": "Analyze Polymarket markets with probability, momentum, volume, liquidity and AI-powered explanations.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Polymarket AI Analyzer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://gamma-api.polymarket.com/*", "https://clob.polymarket.com/*"]
}
