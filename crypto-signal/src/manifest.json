{
  "manifest_version": 3,
  "name": "CryptoSignal AI",
  "short_name": "CryptoSignal",
  "version": "0.0.0",
  "description": "Understand crypto market momentum in seconds: RSI, MACD and EMA signals with a plain-language explanation.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CryptoSignal AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "alarms", "notifications"],
  "host_permissions": ["https://api.binance.com/*", "https://api.exchange.coinbase.com/*"]
}
