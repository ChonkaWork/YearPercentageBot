{
  "manifest_version": 3,
  "name": "Clean Copy",
  "short_name": "Clean Copy",
  "version": "0.0.0",
  "description": "Copy text without fonts, colors, links and invisible junk. Auto-clean every Ctrl+C on the sites you choose.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clean Copy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "offscreen", "clipboardWrite"],
  "optional_host_permissions": ["*://*/*"],
  "commands": {
    "copy-clean": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Copy the selection as clean text"
    }
  }
}
