{
  "name": "pastebot",
  "version": "0.1.0",
  "private": true,
  "description": "Turn selected web content into ready-to-use AI prompts.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.mjs --e2e && node e2e/smoke.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.56.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
