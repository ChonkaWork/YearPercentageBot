{
  "manifest_version": 3,
  "name": "Page Watch",
  "short_name": "Page Watch",
  "version": "0.0.0",
  "description": "Get notified when a web page, or just the price or part you care about, changes. Timestamps and other noise are filtered out.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Page Watch",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "alarms", "notifications", "offscreen", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
